{
  "name": "screen-room",
  "productName": "Screen Room",
  "version": "0.1.0",
  "description": "Screen Room as a Windows app, so sharing includes your computer's sound in any setup.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "web": "node copy-web.js",
    "start": "npm run web && electron .",
    "build": "npm run web && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "peerjs": "1.5.4"
  },
  "allowScripts": {
    "electron-winstaller": false
  },
  "author": "IkariTC",
  "build": {
    "appId": "io.github.ikaritc.screenroom",
    "productName": "Screen Room",
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "web/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "icon.png"
    },
    "portable": {
      "artifactName": "ScreenRoom-${version}.exe"
    }
  }
}
